PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/user_analytics
# Comma-separated list of origins allowed to call the API, or * for any
CORS_ORIGIN=*
# Password for the dashboard. Leave empty to disable the login screen.
DASHBOARD_PASSWORD=change-me
# Optional: key for signing login tokens (defaults to one derived from the password)
AUTH_SECRET=
